{
  "name": "buzzy-abc-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-budgets.ts --quiet",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "optimize-assets": "node scripts/optimize-assets.ts",
    "check-budgets": "node scripts/check-budgets.ts",
    "qa": "vite build --mode e2e --outDir dist-e2e && vite preview --outDir dist-e2e --host --port 4174 --strictPort"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  }
}
